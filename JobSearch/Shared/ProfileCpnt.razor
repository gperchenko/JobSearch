@inherits PageBase



<div class="p-4">

    <div class="flex items-center align-center mb-2">
        <h1 class="text-5xl">Profile: @PageState.Profile?.Name</h1>
    </div>
    <EditForm Model="@newProfile" OnValidSubmit="@SwitchProfile" class="rounded-md border-slate-300 border-2">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="bg-slate-200 p-3 flex gap-2">
            <div class="w-full flex items-center">
                <label for="profileName" class="pr-2">Profile Name</label>
                <InputText id="profileName" @bind-Value="newProfile.Name" class="border-2 border-slate-300 bg-white flex-1 p-2 rounded-md" />
            </div>
            <div>
                @if (LoadingProfile)
                {
                    <p>LoadingProfile Profile</p>
                }
                else
                {
                  <button type="submit" class="@buttonCurrent">Submit</button>
                }
            </div>
        </div>
    </EditForm>
</div>


